# Production API Base URL for the payment gateway backend
VITE_API_BASE_URL=https://checkout.tpipay.ai
# Enable mock data mode (true/false)
VITE_ENABLE_MOCK=false
# App environment: production | test
# production = stay on TPiPay checkout (inline QR / UPI deeplink), never redirect to PayU hosted page
# test = keep legacy behavior (redirect to PayU hosted page via ACS template)
VITE_APP_ENV=production
